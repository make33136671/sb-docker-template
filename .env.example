# ═════════════════════════════════════════════════════════
#  SB Framework Docker 单容器部署配置
#  此文件仅供参考，实际 .env 由 deploy.sh 自动生成
# ═════════════════════════════════════════════════════════

# ── 项目 ──
PROJECT_NAME=myapp
APP_DLL_NAME=MyApp.WebApi.dll

# ── 对外端口 ──
USER_PORT=8080
ADMIN_PORT=8081
API_PORT=8082

# ── PostgreSQL ──
POSTGRES_DB=sb_myapp
POSTGRES_PASSWORD=change_me_in_prod

# ── 数据持久化 ──
# 留空 = Docker 命名卷（内置）
# 填路径 = 绑定挂载到宿主目录（外置）
#   POSTGRES_DATA_PATH=./data/postgres
#   REDIS_DATA_PATH=./data/redis
POSTGRES_DATA_PATH=
REDIS_DATA_PATH=

# ── 维护模式（仅 docker-compose.maint.yml 使用）──
# 宿主机目录 bind-mount 到容器 /app，可直接在宿主机编辑产物/脚本
# 首次启动为空目录时自动从镜像播种；版本升级重新播种: down → 清空该目录 → up
APP_SRC_PATH=./app
